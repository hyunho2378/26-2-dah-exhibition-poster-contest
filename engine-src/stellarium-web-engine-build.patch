diff --git a/src/js/canvas.js b/src/js/canvas.js
index d89aedb..cab085d 100644
--- a/src/js/canvas.js
+++ b/src/js/canvas.js
@@ -21,23 +21,29 @@ Module.afterInit(function() {
     if (mouseDown)
       Module._core_on_mouse(0, 1, mousePos.x, mousePos.y, mouseButtons);
 
+    // Paused while the sky page is not shown.
+    if (Module.paused) {
+      window.requestAnimationFrame(render);
+      return;
+    }
+
     // Check for canvas resize
     var canvas = Module.canvas;
 
     // Get the device pixel ratio, falling back to 1.
-    var dpr = window.devicePixelRatio || 1;
+    var dpr = Math.min(window.devicePixelRatio || 1, Module.maxDpr || 2);
 
     // Get the size of the canvas in CSS pixels.
     var rect = canvas.getBoundingClientRect();
 
     var displayWidth  = rect.width;
     var displayHeight = rect.height;
-    var sizeChanged = (canvas.width  !== displayWidth) ||
-                      (canvas.height !== displayHeight);
+    var sizeChanged = (canvas.width  !== Math.round(displayWidth * dpr)) ||
+                      (canvas.height !== Math.round(displayHeight * dpr));
 
     if (sizeChanged) {
-      canvas.width = displayWidth * dpr;
-      canvas.height = displayHeight * dpr;
+      canvas.width = Math.round(displayWidth * dpr);
+      canvas.height = Math.round(displayHeight * dpr);
     }
 
     // TODO: manage paning and flicking here
diff --git a/src/js/obj.js b/src/js/obj.js
